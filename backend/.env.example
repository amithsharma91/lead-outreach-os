# Lead Outreach OS — environment variable template
#
# Copy to backend/.env and adjust. Values here are placeholders only —
# never commit real credentials.
#
# Precedence (highest wins):
#   1. Environment variables (this file / shell)
#   2. config/settings.json (optional user override of settings.example.json)
#   3. Built-in defaults matching config/settings.example.json
#
# SAFE DEFAULTS are pre-set below. Production MUST be supplied values are
# marked "(required in production)" and are left empty.

# ---------------------------------------------------------------------------
# Application environment
# Supported: development | test | production  (anything else is rejected)
# ---------------------------------------------------------------------------
APP_ENV=development

# SQLite database location. Relative sqlite paths resolve against the
# process working directory — prefer an absolute path in production.
DATABASE_URL=sqlite:///./data/lead_outreach.db

# ---------------------------------------------------------------------------
# Outreach behaviour (SAFE DEFAULTS — do not weaken without authorization)
# ---------------------------------------------------------------------------
OUTREACH_TIMEZONE=Asia/Kolkata
OUTREACH_START_TIME=21:00
OUTREACH_END_TIME=23:00
# 0 = no sends at all. Only raise this when an authorized messaging provider
# defines and approves a limit. Do not invent limits.
DAILY_SEND_LIMIT=0
# Every message must be human-approved before it can be queued/sent.
REQUIRE_HUMAN_APPROVAL=true

# Scheduler (runs the outreach tick; safe while messaging_provider=none)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Provider selection
# MESSAGING_PROVIDER MUST remain "none" until a provider activation
# milestone is explicitly authorized. "whatsapp_openwa" exists only as a
# dormant stub and cannot send.
# ---------------------------------------------------------------------------
AI_PROVIDER=omniroute
MESSAGING_PROVIDER=none

# ---------------------------------------------------------------------------
# AI gateway (OmniRoute) — (required in production when AI features are used)
# ---------------------------------------------------------------------------
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=

# ---------------------------------------------------------------------------
# Qualified-lead notification (second sales number) — (optional)
# ---------------------------------------------------------------------------
NOTIFICATION_PROVIDER=
NOTIFICATION_TARGET=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Set to true to include message content in logs (default: off)
LOG_MESSAGE_CONTENT=false

# ---------------------------------------------------------------------------
# API authentication (PR-C) — bearer-token auth, OFF by default
# ---------------------------------------------------------------------------
# When API_AUTH_ENABLED=true, every /api endpoint except GET /api/health
# requires `Authorization: Bearer <API_AUTH_TOKEN>`.
# Production fail-safe: enabling auth in production WITHOUT a token refuses
# to boot. CHANGE_ME below is a placeholder — the real value MUST come from
# the deployment environment, never from source control.
API_AUTH_ENABLED=false
API_AUTH_TOKEN=CHANGE_ME

# ---------------------------------------------------------------------------
# API rate limiting (PR-C) — in-process, OFF by default
# ---------------------------------------------------------------------------
# Per-client-IP fixed-window limit. Independent of DAILY_SEND_LIMIT (outreach
# sends) — the two controls never interact. In-process limiting is NOT
# suitable for horizontally scaled multi-instance deployments.
API_RATE_LIMIT_ENABLED=false
API_RATE_LIMIT_REQUESTS=300
API_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# CORS (PR-C) — comma-separated origins allowed to call the API
# ---------------------------------------------------------------------------
# Wildcard '*' is rejected while CORS_ALLOW_CREDENTIALS=true.
# Production requires an explicit CORS_ORIGINS value; the development
# default (localhost:5173) is never inherited silently in production.
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true